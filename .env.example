# Supabase Configuration
# Obtain these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: If these keys are not set, RVR_GYM runs in Local Storage mode
# so you can immediately use and test the app without any setup.
# Once added, it will automatically sync to your Supabase cloud database.
